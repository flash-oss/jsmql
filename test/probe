#!/usr/bin/env node
// test/probe — run MQL against the project's mongod and print what the server returned.
// One reusable runner instead of a fresh tmp/*.mjs per check.
// See test/CLAUDE.md "Verify MQL against a running MongoDB".
//
// The server is the project's own instance on :27018, started by `npm run fixture:up`.
// The developer's own mongod on the default port is NEVER used — it holds their real
// work. That rule has no exception; `test/no-default-port.test.ts` holds the line.
//
// Input: MQL JSON as a positional arg, or on stdin if no positional is given.
//   echo '[{"$match":{"age":{"$gt":18}}}]' | ./test/probe
//   ./test/probe '{"$gt":["$age",18]}' --doc '{"age":20}'
//   node ../src/cli.ts --pipeline '$.age > 18' | ./test/probe   # pipe jsmql's MQL straight in
//
// Shape is auto-detected; override with a flag:
//   --pipeline   db.coll.aggregate(<array>)
//   --filter     db.coll.find(<object>)
//   --expr       db.coll.aggregate([{ $addFields: { __v: <object> } }])  — a bare jsmql.expr fragment
//   --update     db.coll.updateMany({}, <object>) then show the resulting docs
// Auto: array → --pipeline; object whose top-level keys ALL start with '$' → --expr
//       (so an update doc like {$set:…} must pass --update explicitly); otherwise → --filter.
//
// Other options:
//   --doc <json>   seed doc(s) before running — object or JSON array, repeatable. Default: {}
//   --uri <uri>    mongod connection string. Default: the project's :27018 instance
//   -o <file>      write output to <file> instead of stdout
//   -h, --help     show this help
//
// Input is JAVASCRIPT, which is what the jsmql CLI writes — `new Date(…)`,
// `new ObjectId(…)`, `/re/i`. It is evaluated with the driver's own BSON classes in
// scope, so probe refuses exactly what a driver script would refuse: that is the point
// of it. Plain JSON still works, because JSON is JavaScript. An Extended JSON WRAPPER
// (`{"$oid": "…"}`) is refused rather than converted — as JavaScript it is a plain
// subdocument that would silently match nothing.
//
// Output goes to stdout (or -o <file>) in the same JavaScript form, so a result can be
// pasted back into --doc. The server's own rejection message is printed verbatim when
// mongod refuses the shape — that refusal IS the signal you're probing for.

import { readFileSync, writeFileSync } from "node:fs";
import * as mongodb from "mongodb";
const { MongoClient, BSON } = mongodb;
import { stringify } from "../src/stringify.ts";
import { SCRATCH_URI } from "./fixtures/config.ts";

// The classes a pasted document may name — the same list the CLI's output depends on.
const BSON_GLOBALS = {
  ObjectId: mongodb.ObjectId, Decimal128: mongodb.Decimal128, Long: mongodb.Long,
  Int32: mongodb.Int32, Double: mongodb.Double, Binary: mongodb.Binary, UUID: mongodb.UUID,
  Timestamp: mongodb.Timestamp, MinKey: mongodb.MinKey, MaxKey: mongodb.MaxKey,
  Code: mongodb.Code, DBRef: mongodb.DBRef, BSONSymbol: BSON.BSONSymbol, BSONRegExp: BSON.BSONRegExp,
};

// Every Extended JSON wrapper. As JavaScript each is an ordinary subdocument, so a
// document holding one runs and matches nothing — the exact failure probe exists to catch.
const WRAPPERS = ["$oid", "$date", "$numberDecimal", "$numberLong", "$numberInt", "$numberDouble",
  "$binary", "$timestamp", "$minKey", "$maxKey", "$code", "$symbol", "$regularExpression", "$uuid", "$ref"];

const refuseWrappers = (v, path, what) => {
  if (v === null || typeof v !== "object" || v._bsontype !== undefined) return;
  if (Array.isArray(v)) return v.forEach((x, i) => refuseWrappers(x, `${path}[${i}]`, what));
  for (const [k, x] of Object.entries(v)) {
    if (WRAPPERS.includes(k)) {
      fail(
        `${what}${path} holds the Extended JSON wrapper '${k}', which probe does not convert — ` +
          `as JavaScript it is a plain subdocument and would not match. ` +
          `Write the value itself instead, e.g. new ObjectId("…") or new Date("…").`,
      );
    }
    refuseWrappers(x, `${path}.${k}`, what);
  }
};

const HELP = readFileSync(new URL(import.meta.url), "utf8")
  .split("\n")
  .filter((l) => l.startsWith("//"))
  .map((l) => l.slice(3))
  .join("\n");

function fail(msg) {
  process.stderr.write(msg + "\n");
  process.exit(1);
}

// --- arg parsing -----------------------------------------------------------
const argv = process.argv.slice(2);
const opts = { docs: [], uri: SCRATCH_URI, out: null, mode: null };
const positionals = [];
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  switch (a) {
    case "-h":
    case "--help":
      process.stdout.write(HELP + "\n");
      process.exit(0);
    case "--pipeline":
    case "--filter":
    case "--expr":
    case "--update":
      opts.mode = a.slice(2);
      break;
    case "--doc":
      opts.docs.push(argv[++i] ?? fail("--doc needs a JSON value"));
      break;
    case "--uri":
      opts.uri = argv[++i] ?? fail("--uri needs a value");
      break;
    case "-o":
    case "--out":
      opts.out = argv[++i] ?? fail("-o needs a file path");
      break;
    default:
      if (a.startsWith("-")) fail(`Unknown option '${a}'. Run with --help.`);
      positionals.push(a);
  }
}

// Evaluated, not parsed: the CLI writes JavaScript. `new Function` reproduces a driver
// script's own scope exactly, so anything it refuses the driver refuses too.
const parse = (s, what) => {
  let v;
  try {
    v = new Function(...Object.keys(BSON_GLOBALS), `return (${s})`)(...Object.values(BSON_GLOBALS));
  } catch (e) {
    fail(`Invalid JavaScript in ${what}: ${e.message}`);
  }
  refuseWrappers(v, "", what);
  return v;
};

// --- read the MQL ----------------------------------------------------------
const raw = positionals.length > 0 ? positionals.join(" ") : readFileSync(0, "utf8");
if (!raw.trim()) fail("No MQL given (pass a positional argument or pipe it on stdin). Run with --help.");
const mql = parse(raw, "MQL input");

// --- decide the shape ------------------------------------------------------
let mode = opts.mode;
if (!mode) {
  if (Array.isArray(mql)) mode = "pipeline";
  else if (mql && typeof mql === "object") {
    const keys = Object.keys(mql);
    mode = keys.length > 0 && keys.every((k) => k.startsWith("$")) ? "expr" : "filter";
  } else {
    fail("MQL must be a JSON array (pipeline) or object (filter / expr / update).");
  }
}

// --- seed docs --------------------------------------------------------------
const seed = opts.docs.length === 0
  ? [{}]
  : opts.docs.flatMap((d) => {
    const parsed = parse(d, "--doc");
    return Array.isArray(parsed) ? parsed : [parsed];
  });

// --- run it -----------------------------------------------------------------
const client = new MongoClient(opts.uri, { serverSelectionTimeoutMS: 2000 });
let result;
try {
  await client.connect();
} catch (e) {
  fail(
    `Could not connect to the project's mongod at ${opts.uri}: ${e.message}\n` +
      "Start it with `npm run fixture:up`. If mongod itself is missing, install it first:\n" +
      "https://www.mongodb.com/docs/manual/administration/install-community/",
  );
}
try {
  const coll = client.db("jsmql_probe").collection("probe");
  await coll.deleteMany({});
  if (seed.length) await coll.insertMany(seed.map((d) => ({ ...d })));

  if (mode === "pipeline") {
    result = await coll.aggregate(mql).toArray();
  } else if (mode === "filter") {
    result = await coll.find(mql).toArray();
  } else if (mode === "expr") {
    result = await coll.aggregate([{ $addFields: { __v: mql } }]).toArray();
  } else {
    const res = await coll.updateMany({}, mql);
    result = {
      matchedCount: res.matchedCount,
      modifiedCount: res.modifiedCount,
      docs: await coll.find({}).toArray(),
    };
  }
} catch (e) {
  // The server rejecting the shape is a real probe result — report it, don't crash silently.
  fail(`mongod rejected the ${mode}: ${e.message}`);
} finally {
  await client.close();
}

// --- emit -------------------------------------------------------------------
const text = stringify(result) + "\n";
if (opts.out) writeFileSync(opts.out, text);
else process.stdout.write(text);
