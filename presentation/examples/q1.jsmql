const yearStart = new Date().startOf("year");
const PAID = "paid";

$$.filter(
  (order) =>
    order.createdAt >= yearStart && order.status === PAID,
)
  .$group({
    _id: $.productId,
    revenue: $sum($.qty * $.price),
  })
  .sort({ revenue: -1 })
  .take(10);

$.name = $$$.products.find({ _id: $._id }).name;
