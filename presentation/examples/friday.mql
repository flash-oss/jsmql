[
    {
        $set: {
            "address.full": {
                $trim: {
                    // Remove leading/trailing spaces
                    input: {
                        $reduce: {
                            input: {
                                $filter: {
                                    input: [
                                        { $concat: ["$address.building1", " ", "$address.building2"] }, // Combine buildings with a space
                                        {
                                            $cond: [{ $and: ["$address.building1", "$address.building2"] }, ",", ""],
                                        }, // Add comma if both buildings exist
                                        "$address.street",
                                        "$address.city",
                                        "$address.country",
                                    ],
                                    as: "field",
                                    cond: { $ne: ["$$field", ""] }, // Exclude null/empty fields
                                },
                            },
                            initialValue: "",
                            in: {
                                $cond: [
                                    { $eq: ["$$value", ""] },
                                    "$$this", // Add field without separator for the first value
                                    { $concat: ["$$value", " ", "$$this"] }, // Add with a space separator
                                ],
                            },
                        },
                    },
                },
            },
        },
    },
];
