{
  "name": "mjsql",
  "version": "0.1.0",
  "description": "Write MongoDB aggregation expressions in JavaScript. JS-subset language that compiles to MQL JSON.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "docs/LANGUAGE.md"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "node vendor/fetch-mql-specs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt ."
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0",
    "oxfmt": "^0.47.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
